# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1: Use a single cloud connection string (Render/Neon/Supabase/Aiven/etc.)
# Examples:
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_URL=mysql://user:password@host:3306/database
DATABASE_URL=

# Option 2: Use local MySQL credentials (when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mellophi_fashion
DB_USER=root
DB_PASSWORD=

# JWT Secret (change this to a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Credentials (first time setup)
ADMIN_EMAIL=admin@mellophifashion.com
ADMIN_PASSWORD=admin123

# Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5500

# PayGate Payment Gateway
PAYGATE_ID=your-paygate-merchant-id
PAYGATE_SECRET=your-paygate-merchant-key
PAYGATE_INITIATE_URL=https://secure.paygate.co.za/payweb3/initiate.trans
PAYGATE_PROCESS_URL=https://secure.paygate.co.za/payweb3/process.trans
PAYGATE_RETURN_URL=http://localhost:5500/payment-return.html
PAYGATE_NOTIFY_URL=http://localhost:5000/api/paygate/notify

# true for local testing without live gateway calls, false for production
PAYGATE_TEST_MODE=true
